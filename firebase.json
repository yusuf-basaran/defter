{
  "functions": [
    {
      "source": "functions",
      "codebase": "defter",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "database": "(default)",
    "location": "europe-west1"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".*",
      "node_modules/**",
      "functions/**",
      "scripts/**",
      "tests/**",
      "docs/**",
      "shared/**",
      "scratch/**",
      "library-files/**",
      "*-debug.log",
      "package*.json",
      "*.rules",
      "firestore.indexes.json"
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true
  },
  "auth": {
    "authorizedDomains": [
      "defterr-prod-2026-da392.firebaseapp.com",
      "defterr-prod-2026-da392.web.app",
      "defterr.vercel.app"
    ],
    "providers": {
      "emailPassword": true,
      "anonymous": false
    }
  }
}
