{
  "name": "defter",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "firebase emulators:start --project demo-defter",
    "test": "node --test tests/totals.test.js tests/model.test.js",
    "test:emulators": "firebase emulators:exec --project demo-defter --only auth,firestore,storage 'node --test --test-concurrency=1 tests/rules.test.js tests/functions.test.js tests/storage.test.js'",
    "test:browser": "node tests/browser.cjs",
    "check": "prettier --check .",
    "format": "prettier --write .",
    "screenshots": "node scripts/capture-screenshots.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "axe-core": "^4.14.0",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.22.0",
    "playwright": "^1.64.1",
    "prettier": "^3.6.2"
  }
}
